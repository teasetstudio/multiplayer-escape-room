{
  "name": "multiplayer-escape-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @escape/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @escape/shared build && pnpm --filter @escape/server test",
    "start": "pnpm --filter @escape/server start",
    "test:browser": "pnpm --filter @escape/server test:browser"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
