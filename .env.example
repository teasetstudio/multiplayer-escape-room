# Copy this file to .env at the workspace root. Restart pnpm dev after editing.
# Default: open http://YOUR_COMPUTER_LAN_IP:5173 on the host and every phone.
# Blank values below use the current browser origin, including WebSockets.
VITE_PUBLIC_CLIENT_URL=
VITE_GAME_SERVER_URL=

# Node server (the Vite proxy connects here during development).
HOST=0.0.0.0
PORT=2567
DEV_SERVER_TARGET=http://127.0.0.1:2567

# Comma-separated exact browser origins. Blank accepts origins for trusted LAN dev.
# Production example: CLIENT_ORIGINS=https://game.your-domain.example
CLIENT_ORIGINS=

# For a tunnel, add only its exact hostname (no https://). Never set allowedHosts=true.
DEV_ALLOWED_HOSTS=

# Optional trusted local HTTPS. Paths are relative to apps/client (or absolute).
# DEV_HTTPS_KEY=../../.certs/lan-key.pem
# DEV_HTTPS_CERT=../../.certs/lan.pem
DEV_HTTPS_KEY=
DEV_HTTPS_CERT=
