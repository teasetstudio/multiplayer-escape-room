{
  "name": "@escape/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@colyseus/core": "~0.17.56",
    "@colyseus/schema": "^4.0.0",
    "@colyseus/ws-transport": "~0.17.0",
    "@escape/shared": "workspace:*",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "~0.17.0",
    "@types/express": "^5.0.3",
    "tsx": "^4.20.6"
  }
}
